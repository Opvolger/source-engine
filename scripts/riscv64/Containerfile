# Cross-compile environment for riscv64 (Milk-V Jupiter / SpacemiT K1 running Debian 13 "trixie").
# Same Debian release as the board, so the binaries link against exactly the library
# sonames that are installed there (e.g. libjpeg.so.62 from libjpeg62-turbo).
#
#   podman build -t source-engine-riscv64 -f scripts/riscv64/Containerfile scripts/riscv64
FROM docker.io/library/debian:trixie

ENV DEBIAN_FRONTEND=noninteractive

RUN dpkg --add-architecture riscv64 \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
    crossbuild-essential-riscv64 python3 python-is-python3 pkg-config git ca-certificates \
    libsimde-dev \
    libsdl2-dev:riscv64 \
    libfreetype-dev:riscv64 \
    libfontconfig-dev:riscv64 \
    libopenal-dev:riscv64 \
    libjpeg-dev:riscv64 \
    libpng-dev:riscv64 \
    libcurl4-openssl-dev:riscv64 \
    zlib1g-dev:riscv64 \
    libbz2-dev:riscv64 \
    libedit-dev:riscv64 \
    libopus-dev:riscv64 \
    libgl-dev:riscv64 \
    libegl-dev:riscv64 \
 && rm -rf /var/lib/apt/lists/*

ENV CC=riscv64-linux-gnu-gcc \
    CXX=riscv64-linux-gnu-g++ \
    AR=riscv64-linux-gnu-ar \
    STRIP=riscv64-linux-gnu-strip \
    PKG_CONFIG_LIBDIR=/usr/lib/riscv64-linux-gnu/pkgconfig:/usr/share/pkgconfig \
    PKG_CONFIG_PATH=

WORKDIR /src
